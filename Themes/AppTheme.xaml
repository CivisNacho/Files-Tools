<?xml version="1.0" encoding="utf-8"?>
<!--
    Media Tools brand theme — full light/dark surface theme.

    Palette derived from the app icon (retro / mid-century):
        Orange    #F07E1B   primary accent
        Charcoal  #3B3531   warm dark base (the dark half of the icon)
        Cream     #EEE9DF   warm light base (the "paper")
        Gray      #B3ADA4   muted warm neutral

    Token reference (Dark / Light):
        Window background  #2B2724 / #EEE9DF
        Surface / card     #3B3531 / #F7F3EC
        Surface elevated   #47403B / #FFFFFF
        Border / divider   #564E48 / #D8D1C5
        Primary text       #EEE9DF / #3B3531
        Secondary text     #B3ADA4 / #7A7269
        Accent             #F07E1B / #E8731A
        Accent hover       #FF9038 / #F07E1B
        Accent pressed     #D96A12 / #C75F10
        On-accent text     #2B2724 / #FFFFFF

    The accent system is set BOTH via the SystemAccentColor* palette (so toggles, checkboxes,
    sliders, progress, focus rings, etc. turn orange) AND via explicit AccentFillColor*Brush /
    TextOnAccentFillColor* overrides (so button rest/hover/pressed and on-accent text hit the
    exact tokens). IMPORTANT: the WinUI XAML markup compiler can intermittently fail with a
    silent "XamlCompiler.exe exited with code 1" (no diagnostic) when this file changes and the
    obj/ folder holds stale incremental state. If a build fails with that error, do a CLEAN
    build: `Remove-Item obj\<plat>\Debug -Recurse -Force` then rebuild.

    Typography (all SIL OFL, free for commercial use):
        Inter   - body / UI text (variable font; per-control FontWeight still works)
        Poppins - headings / display
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ============================  FONTS (theme-independent)  ============================  -->
    <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/Inter.ttf#Inter</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">ms-appx:///Assets/Fonts/Poppins-SemiBold.ttf#Poppins SemiBold</FontFamily>
    <FontFamily x:Key="AppDisplayBoldFontFamily">ms-appx:///Assets/Fonts/Poppins-Bold.ttf#Poppins</FontFamily>
    <FontFamily x:Key="AppDisplayMediumFontFamily">ms-appx:///Assets/Fonts/Poppins-Medium.ttf#Poppins Medium</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter.ttf#Inter</FontFamily>

    <!--  ====================  PER-EDITOR ACCENTS (theme-independent)  ====================
          Re-tinted warm hues that harmonise with the orange/charcoal/cream brand while keeping
          a distinct identity per editor. Mid-tone values read on both cream and charcoal.
          The *Hint brushes are a low-alpha tint of the accent, so they render as a subtle warm
          wash over whichever themed surface sits behind them (no per-theme gradient needed).  -->
    <SolidColorBrush x:Key="ImageAccentBrush" Color="#E2674A" />
    <SolidColorBrush x:Key="ImageAccentDarkBrush" Color="#C44E33" />
    <SolidColorBrush x:Key="ImageHintBackgroundBrush" Color="#26E2674A" />

    <SolidColorBrush x:Key="AudioAccentBrush" Color="#B0628F" />
    <SolidColorBrush x:Key="AudioAccentDarkBrush" Color="#8E4A72" />
    <SolidColorBrush x:Key="AudioHintBackgroundBrush" Color="#26B0628F" />

    <SolidColorBrush x:Key="VideoAccentBrush" Color="#3F9E8F" />
    <SolidColorBrush x:Key="VideoAccentDarkBrush" Color="#2E7C70" />
    <SolidColorBrush x:Key="VideoHintBackgroundBrush" Color="#263F9E8F" />

    <SolidColorBrush x:Key="PdfAccentBrush" Color="#E0A12E" />
    <SolidColorBrush x:Key="PdfAccentDarkBrush" Color="#C07E16" />
    <SolidColorBrush x:Key="PdfHintBackgroundBrush" Color="#26E0A12E" />

    <SolidColorBrush x:Key="DocumentAccentBrush" Color="#CF6B33" />
    <SolidColorBrush x:Key="DocumentAccentDarkBrush" Color="#AE5320" />
    <SolidColorBrush x:Key="DocumentHintBackgroundBrush" Color="#26CF6B33" />

    <SolidColorBrush x:Key="BatchAccentBrush" Color="#8E6BB0" />
    <SolidColorBrush x:Key="BatchAccentDarkBrush" Color="#6F4F92" />
    <SolidColorBrush x:Key="BatchHintBackgroundBrush" Color="#268E6BB0" />

    <!--  Body font: make Inter the default for standalone TextBlocks app-wide. (Controls already
          pick up Inter via ContentControlThemeFontFamily; raw TextBlocks do not, hence this
          implicit style.) Headings set FontFamily="{ThemeResource AppDisplayFontFamily}" locally,
          which overrides this setter.  -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
    </Style>

    <!--  ============================  COLORS (theme-aware)  ============================  -->
    <ResourceDictionary.ThemeDictionaries>

        <!--  ============================  LIGHT THEME  ============================  -->
        <ResourceDictionary x:Key="Light">

            <!--  Brand swatches (use directly in pages)  -->
            <Color x:Key="BrandOrangeColor">#E8731A</Color>
            <Color x:Key="BrandCharcoalColor">#3B3531</Color>
            <Color x:Key="BrandCreamColor">#EEE9DF</Color>
            <Color x:Key="BrandGrayColor">#7A7269</Color>
            <SolidColorBrush x:Key="BrandOrangeBrush" Color="#E8731A" />
            <SolidColorBrush x:Key="BrandCharcoalBrush" Color="#3B3531" />
            <SolidColorBrush x:Key="BrandCreamBrush" Color="#EEE9DF" />
            <SolidColorBrush x:Key="BrandGrayBrush" Color="#7A7269" />

            <!--  Accent palette (drives toggles / checks / sliders / focus / progress)  -->
            <Color x:Key="SystemAccentColor">#F07E1B</Color>
            <Color x:Key="SystemAccentColorDark1">#E8731A</Color>
            <Color x:Key="SystemAccentColorDark2">#D96A12</Color>
            <Color x:Key="SystemAccentColorDark3">#C75F10</Color>
            <Color x:Key="SystemAccentColorLight1">#FF9038</Color>
            <Color x:Key="SystemAccentColorLight2">#FFA45A</Color>
            <Color x:Key="SystemAccentColorLight3">#FFB87D</Color>

            <!--  Accent fills: rest / hover / pressed + accent-coloured text + on-accent text  -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E8731A" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F07E1B" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C75F10" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#C75F10" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B0540C" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#E8731A" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#F2ECE2" />

            <!--  Text ladder  -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#3B3531" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#7A7269" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#9A9189" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#B9B1A6" />

            <!--  Window background (base)  -->
            <Color x:Key="SolidBackgroundFillColorBase">#EEE9DF</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#E6E0D4</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#FFFFFF</Color>
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#EEE9DF" />

            <!--  Surface / card (mid)  -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F7F3EC" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#F7F3EC" />

            <!--  Surface elevated (top): cards, inputs, flyouts, menus, dialogs  -->
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#F2EDE5" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#EAE4DA" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#F0EBE2" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E6E0D4" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#DED7CB" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />

            <!--  Border / divider  -->
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#D8D1C5" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#D8D1C5" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#D8D1C5" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D8D1C5" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#CBC3B5" />
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#D8D1C5" />
            <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#B9B0A2" />

            <!--  NavigationView pane / content surfaces  -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EEE9DF" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EEE9DF" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#EEE9DF" />
        </ResourceDictionary>

        <!--  ============================  DARK THEME  ============================  -->
        <ResourceDictionary x:Key="Dark">

            <!--  Brand swatches (use directly in pages)  -->
            <Color x:Key="BrandOrangeColor">#F07E1B</Color>
            <Color x:Key="BrandCharcoalColor">#3B3531</Color>
            <Color x:Key="BrandCreamColor">#EEE9DF</Color>
            <Color x:Key="BrandGrayColor">#B3ADA4</Color>
            <SolidColorBrush x:Key="BrandOrangeBrush" Color="#F07E1B" />
            <SolidColorBrush x:Key="BrandCharcoalBrush" Color="#3B3531" />
            <SolidColorBrush x:Key="BrandCreamBrush" Color="#EEE9DF" />
            <SolidColorBrush x:Key="BrandGrayBrush" Color="#B3ADA4" />

            <!--  Accent palette (drives toggles / checks / sliders / focus / progress)  -->
            <Color x:Key="SystemAccentColor">#F07E1B</Color>
            <Color x:Key="SystemAccentColorLight1">#FF9038</Color>
            <Color x:Key="SystemAccentColorLight2">#F07E1B</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA45A</Color>
            <Color x:Key="SystemAccentColorDark1">#D96A12</Color>
            <Color x:Key="SystemAccentColorDark2">#C75F10</Color>
            <Color x:Key="SystemAccentColorDark3">#B0540C</Color>

            <!--  Accent fills: rest / hover / pressed + accent-coloured text + on-accent text  -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F07E1B" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF9038" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D96A12" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFA45A" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFB87D" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#F07E1B" />
            <!--  Dark text on the bright orange reads better than white.  -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#2B2724" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#46403B" />

            <!--  Text ladder  -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EEE9DF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B3ADA4" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C857D" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#6E665E" />

            <!--  Window background (base)  -->
            <Color x:Key="SolidBackgroundFillColorBase">#2B2724</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#322D2A</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#47403B</Color>
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#2B2724" />

            <!--  Surface / card (mid)  -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#3B3531" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#3B3531" />

            <!--  Surface elevated (top): cards, inputs, flyouts, menus, dialogs  -->
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#47403B" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#47403B" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#47403B" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#514A44" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#3B3531" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#332E2B" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#3B3531" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#443E39" />
            <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#47403B" />
            <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#47403B" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#3B3531" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#47403B" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#47403B" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#47403B" />

            <!--  Border / divider  -->
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#564E48" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#564E48" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#564E48" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#564E48" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#635B53" />
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#564E48" />
            <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#6E665E" />

            <!--  NavigationView pane / content surfaces  -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#2B2724" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#2B2724" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#2B2724" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
