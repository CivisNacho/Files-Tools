<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files_Tools.Pages.VideoEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  Accent/hint brushes (Image*/Video* accent + VideoHintBackgroundBrush) are defined
              app-wide and theme-aware in Themes/AppTheme.xaml.  -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid
            x:Name="PageRoot"
            Padding="32,24,32,28"
            SizeChanged="PageRoot_SizeChanged">
            <Grid
                x:Name="ContentRoot"
                HorizontalAlignment="Stretch"
                RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel MaxWidth="880" Spacing="6">
                    <TextBlock x:Uid="VideoPage_Title" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="38" FontWeight="SemiBold" Text="Video Editor" />
                    <TextBlock
                        x:Uid="VideoPage_Subtitle"
                        Opacity="0.78"
                        Text="Import a video, tune processing options, and run FFmpeg-backed edits with a layout that keeps preview and decisions easy to follow."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    x:Name="EditorGrid"
                    Grid.Row="1"
                    ColumnSpacing="20"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="8*" />
                        <ColumnDefinition x:Name="RightColumn" Width="4*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="PreviewSection"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Padding="20"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="PreviewTitle" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="24" FontWeight="SemiBold" Text="Preview" />
                                <TextBlock
                                    x:Uid="VideoPage_PreviewHint"
                                    Opacity="0.72"
                                    Text="Drop a video or click the preview surface to start. Playback and edit options stay centered around this working area."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                x:Name="UploadSurface"
                                Grid.Row="1"
                                AllowDrop="True"
                                MinHeight="200"
                                Padding="16"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                DragOver="UploadSurface_DragOver"
                                Drop="UploadSurface_Drop"
                                PointerPressed="UploadSurface_PointerPressed">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid
                                        x:Name="PreviewHost"
                                        SizeChanged="PreviewHost_SizeChanged">
                                        <MediaPlayerElement
                                            x:Name="VideoPlayer"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            AreTransportControlsEnabled="True"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                        <Canvas x:Name="SubtitlePlacementCanvas">
                                            <Primitives:Thumb
                                                x:Name="SubtitlePlacementMarker"
                                                Width="180"
                                                MinHeight="58"
                                                Visibility="Collapsed"
                                                DragDelta="SubtitlePlacementMarker_DragDelta">
                                                <Primitives:Thumb.Template>
                                                    <ControlTemplate TargetType="Primitives:Thumb">
                                                        <Border
                                                            Padding="12,10"
                                                            CornerRadius="12"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    x:Uid="VideoPage_SubtitlePosition"
                                                                    Foreground="White"
                                                                    FontWeight="SemiBold"
                                                                    Text="Subtitle position" />
                                                                <TextBlock
                                                                    x:Name="SubtitlePlacementPreviewTextBlock"
                                                                    x:Uid="VideoPage_DragToPlace"
                                                                    Foreground="White"
                                                                    Opacity="0.82"
                                                                    Text="Drag to place subtitles"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Primitives:Thumb.Template>
                                            </Primitives:Thumb>
                                        </Canvas>
                                    </Grid>

                                    <StackPanel
                                        x:Name="TrimTimelinePanel"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        Spacing="8">
                                        <TextBlock
                                            x:Name="TrimSelectionInfoTextBlock"
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="00:00:00 - 00:00:00" />

                                        <Grid>
                                            <Canvas
                                                x:Name="TrimTimelineCanvas"
                                                Height="36"
                                                HorizontalAlignment="Stretch"
                                                SizeChanged="TrimTimelineCanvas_SizeChanged"
                                                PointerMoved="TrimTimelineCanvas_PointerMoved"
                                                PointerReleased="TrimTimelineCanvas_PointerReleased"
                                                PointerCanceled="TrimTimelineCanvas_PointerReleased">
                                                <Border
                                                    x:Name="TrimTimelineRail"
                                                    Height="6"
                                                    Width="0"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                <Border
                                                    x:Name="TrimSelectedRange"
                                                    Height="6"
                                                    Width="0"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Border
                                                    x:Name="TrimStartHandle"
                                                    Width="16"
                                                    Height="24"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    PointerPressed="TrimHandle_PointerPressed"
                                                    Tag="Start" />
                                                <Border
                                                    x:Name="TrimEndHandle"
                                                    Width="16"
                                                    Height="24"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    PointerPressed="TrimHandle_PointerPressed"
                                                    Tag="End" />
                                            </Canvas>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="TrimStartTimeTextBlock"
                                                Text="00:00:00"
                                                Opacity="0.76" />
                                            <TextBlock
                                                x:Name="TrimEndTimeTextBlock"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Text="00:00:00"
                                                Opacity="0.76" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="DropHintPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Grid.RowSpan="2"
                                        MaxWidth="360"
                                        Spacing="12">
                                        <Border
                                            HorizontalAlignment="Center"
                                            Padding="18"
                                            CornerRadius="999"
                                            Background="{StaticResource VideoHintBackgroundBrush}">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                FontSize="52"
                                                Foreground="{StaticResource VideoAccentDarkBrush}"
                                                Glyph="&#xE714;" />
                                        </Border>
                                        <TextBlock
                                            x:Uid="VideoPage_DropHintTitle"
                                            HorizontalAlignment="Center"
                                            FontFamily="{ThemeResource AppDisplayFontFamily}"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Text="Drop a video here"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            x:Uid="VideoPage_DropHintSubtitle"
                                            HorizontalAlignment="Center"
                                            Opacity="0.76"
                                            Text="You can also click this surface to browse for a file. Trim, resize, repair, and container options stay available from the options panel."
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="LoadedVideoInfoTextBlock"
                                    x:Uid="VideoPage_NoVideoLoaded"
                                    VerticalAlignment="Center"
                                    Opacity="0.76"
                                    Text="No video loaded yet."
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="ApplyButton"
                                    x:Uid="ApplyChanges"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    Height="44"
                                    HorizontalAlignment="Right"
                                    Content="Apply changes"
                                    Background="{StaticResource ImageAccentBrush}"
                                    BorderBrush="{StaticResource ImageAccentBrush}"
                                    Foreground="White"
                                    Click="ApplyButton_Click" />
                            </Grid>

                            <Border
                                x:Name="SubtitleEditorBorder"
                                Grid.Row="4"
                                Padding="12"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Visibility="Collapsed">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Uid="VideoPage_TranscriptionReview" FontWeight="SemiBold" Text="Transcription review" />
                                    <TextBlock x:Uid="VideoPage_TranscriptionReviewHint" Opacity="0.76" Text="Review each Whisper segment here before the app generates the final ASS subtitles for export. Your edits are applied automatically when you process the video." TextWrapping="Wrap" />
                                    <ScrollViewer
                                        MinHeight="180"
                                        MaxHeight="320"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel
                                            x:Name="SubtitleEditorItemsPanel"
                                            Spacing="8" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="SubtitleEditorStatusTextBlock" x:Uid="VideoPage_SubtitleEditorStatus" Opacity="0.76" Text="Generate or choose a subtitle file to edit." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel
                                x:Name="ProcessingStatusPanel"
                                Grid.Row="3"
                                Visibility="Collapsed"
                                Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="ProcessingStatusTextBlock"
                                        x:Uid="VideoPage_Processing"
                                        FontWeight="SemiBold"
                                        Text="Processing video..." />
                                    <TextBlock
                                        x:Name="ProcessingEtaTextBlock"
                                        x:Uid="EtaCalculating"
                                        Grid.Column="1"
                                        Opacity="0.76"
                                        Text="ETA calculating..." />
                                </Grid>

                                <ProgressBar
                                    x:Name="ProcessingProgressBar"
                                    Height="6"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0" />

                                <TextBlock
                                    x:Name="ProcessingDetailTextBlock"
                                    x:Uid="VideoPage_PreparingFFmpeg"
                                    Opacity="0.76"
                                    Text="Preparing FFmpeg..." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="OptionsPanel"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        MinWidth="280"
                        Padding="20"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="SelectedOptionHeaderTextBlock" x:Uid="SelectOptionHeader" Margin="0,0,0,12" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="Select an option" />

                                    <StackPanel x:Name="MediaPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="MediaFormatPanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_FormatAndCodecs" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Format and codecs" />
                                                    <ComboBox x:Name="OutputContainerComboBox" x:Uid="VideoPage_OutputFormat" Header="Output format" SelectionChanged="OutputContainerComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="VideoPage_KeepOriginal" Content="Keep original" />
                                                        <ComboBoxItem Content="MP4" />
                                                        <ComboBoxItem Content="MKV" />
                                                        <ComboBoxItem Content="WebM" />
                                                        <ComboBoxItem Content="MOV" />
                                                        <ComboBoxItem Content="AVI" />
                                                        <ComboBoxItem Content="GIF" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="VideoCodecComboBox" x:Uid="VideoPage_VideoCodec" Header="Video codec" PlaceholderText="Video codec" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                        <ComboBoxItem x:Uid="VideoPage_KeepOriginal" Content="Keep original" />
                                                        <ComboBoxItem Content="H264" />
                                                        <ComboBoxItem Content="H265" />
                                                        <ComboBoxItem Content="AV1" />
                                                        <ComboBoxItem Content="VP9" />
                                                        <ComboBoxItem Content="VP8" />
                                                        <ComboBoxItem Content="MPEG4" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="AudioCodecComboBox" x:Uid="VideoPage_AudioCodec" Header="Audio codec" PlaceholderText="Audio codec" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                        <ComboBoxItem x:Uid="VideoPage_KeepOriginal" Content="Keep original" />
                                                        <ComboBoxItem Content="AAC" />
                                                        <ComboBoxItem Content="Opus" />
                                                        <ComboBoxItem Content="Vorbis" />
                                                        <ComboBoxItem Content="MP3" />
                                                        <ComboBoxItem Content="AC3" />
                                                        <ComboBoxItem Content="FLAC" />
                                                        <ComboBoxItem Content="PCM_S16LE" />
                                                        <ComboBoxItem x:Uid="VideoPage_RemoveAudio" Content="Remove audio" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="MediaCompressionPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_Compression" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Compression" />
                                                    <CheckBox x:Name="EnableCompressionCheckBox" x:Uid="VideoPage_EnableCompression" Content="Enable compression preset" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <ContentControl x:Name="CompressionOptionsPanel">
                                                        <ComboBox x:Name="CompressionPresetComboBox" x:Uid="VideoPage_CompressionPreset" Header="Compression preset" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                            <ComboBoxItem Content="VeryHigh" />
                                                            <ComboBoxItem Content="High" />
                                                            <ComboBoxItem Content="Balanced" />
                                                            <ComboBoxItem Content="SmallSize" />
                                                        </ComboBox>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="MediaAudioPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_AudioAndVolume" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Audio and volume" />
                                                    <Button
                                                        x:Name="ExtractAudioButton"
                                                        x:Uid="VideoPage_ExtractAudio"
                                                        HorizontalAlignment="Left"
                                                        Content="Extract audio"
                                                        Click="ExtractAudioButton_Click" />
                                                    <CheckBox x:Name="EnableAudioVolumeCheckBox" x:Uid="VideoPage_AdjustVolume" Content="Adjust output volume" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <StackPanel x:Name="AudioVolumePanel" Spacing="4">
                                                        <TextBlock x:Name="AudioVolumeTextBlock" Text="Volume: 100%" />
                                                        <Slider
                                                            x:Name="AudioVolumeSlider"
                                                            Minimum="0"
                                                            Maximum="200"
                                                            StepFrequency="1"
                                                            Value="100"
                                                            ValueChanged="AudioVolumeSlider_ValueChanged" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        x:Uid="VideoPage_VolumeHint"
                                                        Opacity="0.76"
                                                        Text="This slider changes the final exported audio level, including replacement audio when muxing is enabled."
                                                        TextWrapping="Wrap" />
                                                    <CheckBox x:Name="EnableNormalizeAudioCheckBox" x:Uid="VideoPage_NormalizeAudio" Content="Normalize audio" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <StackPanel x:Name="NormalizeAudioPanel" Spacing="4">
                                                        <TextBlock
                                                            x:Uid="VideoPage_NormalizeHint"
                                                            Opacity="0.76"
                                                            Text="Applies a simple loudness normalization pass to the final output audio."
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="EnableAudioSyncCheckBox" x:Uid="VideoPage_FixAudioSync" Content="Fix audio sync" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <StackPanel x:Name="AudioSyncPanel" Spacing="8">
                                                        <ComboBox x:Name="AudioSyncDirectionComboBox" x:Uid="VideoPage_MoveAudio" Header="Move audio" SelectionChanged="AudioSyncDirectionComboBox_SelectionChanged">
                                                            <ComboBoxItem x:Uid="VideoPage_Earlier" Content="Earlier" />
                                                            <ComboBoxItem x:Uid="VideoPage_Later" Content="Later" />
                                                        </ComboBox>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock x:Name="AudioSyncOffsetTextBlock" Text="Audio offset: 0 ms earlier" />
                                                            <Slider
                                                                x:Name="AudioSyncOffsetSlider"
                                                                Minimum="0"
                                                                Maximum="5000"
                                                                StepFrequency="1"
                                                                Value="0"
                                                                ValueChanged="AudioSyncOffsetSlider_ValueChanged" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox x:Name="EnableAudioDenoiseCheckBox" x:Uid="VideoPage_ApplyDenoise" Content="Apply audio denoise" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <StackPanel x:Name="AudioDenoisePanel" Spacing="8">
                                                        <ComboBox x:Name="AudioDenoiseModeComboBox" x:Uid="VideoPage_DenoiseMode" Header="Denoise mode" SelectionChanged="AudioDenoiseModeComboBox_SelectionChanged">
                                                            <ComboBoxItem x:Uid="VideoPage_DenoiseMono" Content="Mono" />
                                                            <ComboBoxItem x:Uid="VideoPage_DenoiseStereo" Content="Stereo" />
                                                        </ComboBox>
                                                        <StackPanel x:Name="AudioDenoiseStrengthPanel" Spacing="4">
                                                            <TextBlock x:Name="AudioDenoiseStrengthTextBlock" Text="Strength: 50%" />
                                                            <Slider
                                                                x:Name="AudioDenoiseStrengthSlider"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                StepFrequency="1"
                                                                Value="100"
                                                                ValueChanged="AudioDenoiseStrengthSlider_ValueChanged" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox x:Name="EnableAudioMuxCheckBox" x:Uid="VideoPage_AddReplaceAudio" Content="Add or replace audio track" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <ContentControl x:Name="AudioMuxOptionsPanel">
                                                        <StackPanel Spacing="12">
                                                            <TextBox x:Name="AudioMuxPathTextBox" x:Uid="VideoPage_AudioFile" Header="Audio file" PlaceholderText="Choose an audio source" TextChanged="AnyOptionChanged_TextChanged" />
                                                            <Button x:Uid="VideoPage_BrowseAudio" HorizontalAlignment="Left" Content="Browse audio file" Click="BrowseAudioMuxButton_Click" />
                                                            <CheckBox x:Name="ReplaceAudioCheckBox" x:Uid="VideoPage_ReplaceAudio" Content="Replace existing audio" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                            <CheckBox x:Name="UseShortestCheckBox" x:Uid="VideoPage_UseShortest" Content="Use shortest duration" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                            <CheckBox x:Name="SetDefaultAudioCheckBox" x:Uid="VideoPage_SetDefaultAudio" Content="Set as default audio" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                        </StackPanel>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="MediaSubtitlesPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_Subtitles" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Subtitles" />
                                                    <Border
                                                        Padding="12"
                                                        CornerRadius="10"
                                                        BorderThickness="1"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Uid="VideoPage_TranscriptionHeader" FontWeight="SemiBold" Text="Transcription" />
                                                            <TextBlock
                                                                x:Uid="VideoPage_TranscriptionHint"
                                                                Opacity="0.76"
                                                                Text="Choose basic SRT or advanced styled ASS subtitles generation."
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                x:Name="DownloadTranscriptionFeatureButton"
                                                                x:Uid="VideoPage_DownloadTranscription"
                                                                MinWidth="200"
                                                                Height="40"
                                                                HorizontalAlignment="Left"
                                                                Content="Download transcription feature"
                                                                Click="DownloadTranscriptionFeatureButton_Click" />
                                                            <ProgressBar
                                                                x:Name="TranscriptionDownloadProgressBar"
                                                                Height="6"
                                                                Minimum="0"
                                                                Maximum="1"
                                                                Value="0" />
                                                            <TextBlock
                                                                x:Name="TranscriptionDownloadStatusTextBlock"
                                                                x:Uid="VideoPage_TranscriptionNotDownloaded"
                                                                Opacity="0.76"
                                                                Text="Transcription feature not downloaded yet."
                                                                TextWrapping="Wrap" />

                                                            <ComboBox x:Name="SubtitleGenerationModeComboBox" x:Uid="VideoPage_SubtitleGenMode" Header="Subtitle generation mode" SelectionChanged="SubtitleGenerationModeComboBox_SelectionChanged">
                                                                <ComboBoxItem x:Uid="VideoPage_BasicSRT" Content="Basic (SRT)" />
                                                                <ComboBoxItem x:Uid="VideoPage_AdvancedASS" Content="Advanced (ASS)" />
                                                            </ComboBox>

                                                            <StackPanel x:Name="AdvancedSubtitleOptionsPanel" Spacing="8" Visibility="Collapsed">
                                                                <ComboBox x:Name="AdvancedSubtitleTypeComboBox" x:Uid="VideoPage_AdvancedOutputType" Header="Advanced output type" SelectionChanged="AdvancedSubtitleTypeComboBox_SelectionChanged">
                                                                    <ComboBoxItem x:Uid="VideoPage_StyledASS" Content="Styled ASS" />
                                                                    <ComboBoxItem x:Uid="VideoPage_KaraokeASS" Content="Karaoke ASS" />
                                                                </ComboBox>
                                                                <Button
                                                                    x:Name="ConfigureAdvancedSubtitlesButton"
                                                                    x:Uid="VideoPage_ConfigureAdvanced"
                                                                    HorizontalAlignment="Left"
                                                                    Content="Configure advanced subtitles"
                                                                    Click="ConfigureAdvancedSubtitlesButton_Click" />
                                                                <TextBlock
                                                                    x:Name="AdvancedSubtitlePresetSummaryTextBlock"
                                                                    Opacity="0.76"
                                                                    Text="Preset: SocialImpact (default)"
                                                                    TextWrapping="Wrap" />
                                                                <StackPanel Spacing="6">
                                                                    <TextBlock x:Name="SubtitleSectionDurationTextBlock" Text="Advanced subtitle section length: 6.5 s max" />
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="124" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Slider
                                                                            x:Name="SubtitleSectionDurationSlider"
                                                                            Minimum="2"
                                                                            Maximum="12"
                                                                            StepFrequency="0.5"
                                                                            SmallChange="0.5"
                                                                            LargeChange="1"
                                                                            Value="6.5"
                                                                            ValueChanged="SubtitleSectionDurationSlider_ValueChanged" />
                                                                        <NumberBox
                                                                            x:Name="SubtitleSectionDurationNumberBox"
                                                                            x:Uid="VideoPage_SecondsMax"
                                                                            Grid.Column="1"
                                                                            Header="Seconds max"
                                                                            Minimum="2"
                                                                            Maximum="12"
                                                                            SmallChange="0.5"
                                                                            SpinButtonPlacementMode="Compact"
                                                                            Value="6.5"
                                                                            ValueChanged="SubtitleSectionDurationNumberBox_ValueChanged" />
                                                                    </Grid>
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="124" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox
                                                                            x:Name="EnableSubtitleSectionWordCapCheckBox"
                                                                            x:Uid="VideoPage_LimitWords"
                                                                            Content="Limit words per section"
                                                                            VerticalAlignment="Center"
                                                                            Checked="AnyOptionChanged_CheckChanged"
                                                                            Unchecked="AnyOptionChanged_CheckChanged" />
                                                                        <NumberBox
                                                                            x:Name="SubtitleSectionWordCapNumberBox"
                                                                            x:Uid="VideoPage_WordsMax"
                                                                            Grid.Column="1"
                                                                            Header="Words max"
                                                                            Minimum="1"
                                                                            SmallChange="1"
                                                                            SpinButtonPlacementMode="Compact"
                                                                            IsEnabled="False"
                                                                            Value="3"
                                                                            ValueChanged="AnyOptionChanged_NumberChanged" />
                                                                    </Grid>
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                    </Grid>
                                                                    <TextBlock
                                                                        x:Uid="VideoPage_SectionHint"
                                                                        Opacity="0.76"
                                                                        Text="Seconds limits how long a section can stay on screen. Words max limits how many words can stay in one section when enabled."
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Button
                                                                x:Name="GenerateSubtitlesButton"
                                                                x:Uid="VideoPage_GenerateSubtitles"
                                                                HorizontalAlignment="Left"
                                                                Content="Generate subtitles from video"
                                                                Click="GenerateSubtitlesButton_Click" />
                                                            <ProgressBar
                                                                x:Name="TranscriptionProgressBar"
                                                                Height="6"
                                                                Minimum="0"
                                                                Maximum="1"
                                                                Value="0"
                                                                Visibility="Collapsed" />
                                                            <TextBlock
                                                                x:Name="TranscriptionEtaTextBlock"
                                                                x:Uid="EtaCalculating"
                                                                Opacity="0.76"
                                                                Text="ETA calculating..."
                                                                TextWrapping="Wrap"
                                                                Visibility="Collapsed" />
                                                            <TextBlock
                                                                x:Name="TranscriptionReadyStatusTextBlock"
                                                                x:Uid="VideoPage_SubtitlesNotGenerated"
                                                                Opacity="0.76"
                                                                Text="Subtitles not generated yet."
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <CheckBox x:Name="EnableSubtitleMuxCheckBox" x:Uid="VideoPage_AddSubtitles" Content="Add subtitles" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <ContentControl x:Name="SubtitleMuxOptionsPanel">
                                                        <StackPanel Spacing="12">
                                                            <TextBox x:Name="SubtitlePathTextBox" x:Uid="VideoPage_SubtitleFile" Header="Subtitle file" PlaceholderText="Choose a subtitle source" TextChanged="AnyOptionChanged_TextChanged" />
                                                            <Button x:Uid="VideoPage_BrowseSubtitle" HorizontalAlignment="Left" Content="Browse subtitle file" Click="BrowseSubtitleMuxButton_Click" />
                                                            <ComboBox x:Name="SubtitleModeComboBox" x:Uid="VideoPage_SubtitleMode" Header="Subtitle mode" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                                <ComboBoxItem x:Uid="VideoPage_SoftMux" Content="SoftMux" />
                                                                <ComboBoxItem x:Uid="VideoPage_BurnIn" Content="BurnIn" />
                                                            </ComboBox>
                                                            <Border
                                                                Padding="12"
                                                                CornerRadius="10"
                                                                BorderThickness="1"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                                <StackPanel Spacing="10">
                                                                    <TextBlock x:Uid="VideoPage_Placement" FontWeight="SemiBold" Text="Placement" />
                                                                    <TextBlock
                                                                        x:Uid="VideoPage_PlacementHint"
                                                                        Opacity="0.76"
                                                                        Text="Drag the subtitle badge on the preview or fine-tune the placement here."
                                                                        TextWrapping="Wrap" />
                                                                    <Grid ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <NumberBox
                                                                            x:Name="SubtitlePlacementXNumberBox"
                                                                            x:Uid="VideoPage_Horizontal"
                                                                            Header="Horizontal (%)"
                                                                            Minimum="0"
                                                                            Maximum="100"
                                                                            SmallChange="1"
                                                                            SpinButtonPlacementMode="Compact"
                                                                            Value="50"
                                                                            ValueChanged="SubtitlePlacementXNumberBox_ValueChanged" />
                                                                        <NumberBox
                                                                            x:Name="SubtitlePlacementYNumberBox"
                                                                            x:Uid="VideoPage_Vertical"
                                                                            Grid.Column="1"
                                                                            Header="Vertical (%)"
                                                                            Minimum="0"
                                                                            Maximum="100"
                                                                            SmallChange="1"
                                                                            SpinButtonPlacementMode="Compact"
                                                                            Value="88"
                                                                            ValueChanged="SubtitlePlacementYNumberBox_ValueChanged" />
                                                                    </Grid>
                                                                    <Button
                                                                        x:Name="ResetSubtitlePlacementButton"
                                                                        x:Uid="VideoPage_ResetPlacement"
                                                                        HorizontalAlignment="Left"
                                                                        Content="Reset placement"
                                                                        Click="ResetSubtitlePlacementButton_Click" />
                                                                    <TextBlock
                                                                        x:Name="SubtitlePlacementStatusTextBlock"
                                                                        x:Uid="VideoPage_PlacementStatus"
                                                                        Opacity="0.76"
                                                                        Text="Placement is rendered exactly for generated ASS subtitles and approximated for burn-in text subtitles, including boxed and animated presentation presets."
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBox x:Name="SubtitleLanguageTextBox" x:Uid="VideoPage_LanguageTag" Header="Language tag" PlaceholderText="Example: en" TextChanged="AnyOptionChanged_TextChanged" />
                                                            <TextBox x:Name="SubtitleTitleTextBox" x:Uid="VideoPage_SubtitleTitle" Header="Subtitle title" PlaceholderText="Example: English" TextChanged="AnyOptionChanged_TextChanged" />
                                                            <CheckBox x:Name="SetDefaultSubtitleCheckBox" x:Uid="VideoPage_SetDefaultSubtitle" Content="Set as default subtitle" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                        </StackPanel>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="MediaValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel x:Name="TransformPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="TransformResizePanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_Resize" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Resize" />
                                                    <CheckBox x:Name="EnableResizeCheckBox" x:Uid="VideoPage_EnableResize" Content="Enable resize" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <ContentControl x:Name="ResizeOptionsPanel">
                                                        <StackPanel Spacing="12">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <NumberBox x:Name="ResizeWidthNumberBox" x:Uid="VideoPage_Width" Header="Width" Minimum="1" Value="1920" SpinButtonPlacementMode="Compact" ValueChanged="AnyOptionChanged_NumberChanged" />
                                                                <NumberBox x:Name="ResizeHeightNumberBox" x:Uid="VideoPage_Height" Grid.Column="1" Header="Height" Minimum="1" Value="1080" SpinButtonPlacementMode="Compact" ValueChanged="AnyOptionChanged_NumberChanged" />
                                                            </Grid>
                                                            <ComboBox x:Name="ResizeModeComboBox" x:Uid="VideoPage_ResizeMode" Header="Resize mode" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                                <ComboBoxItem x:Uid="VideoPage_PadToFit" Content="PadToFit" />
                                                                <ComboBoxItem x:Uid="VideoPage_CropToFill" Content="CropToFill" />
                                                                <ComboBoxItem x:Uid="VideoPage_Stretch" Content="Stretch" />
                                                            </ComboBox>
                                                            <TextBox x:Name="PadColorTextBox" x:Uid="VideoPage_PaddingColor" Header="Padding color" PlaceholderText="For example black or #000000" Text="black" TextChanged="AnyOptionChanged_TextChanged" />
                                                        </StackPanel>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="TransformTrimPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_Trim" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Trim" />
                                                    <CheckBox x:Name="EnableTrimCheckBox" x:Uid="VideoPage_EnableTrim" Content="Enable trim" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <TextBlock
                                                        x:Uid="VideoPage_TrimHint"
                                                        Opacity="0.76"
                                                        Text="Drag the trim handles under the preview to choose the start and end points."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="TransformRotatePanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_RotateAndMirror" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Rotate and mirror" />
                                                    <ComboBox x:Name="RotationComboBox" x:Uid="VideoPage_Rotation" Header="Rotation" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                        <ComboBoxItem Content="0" />
                                                        <ComboBoxItem Content="90" />
                                                        <ComboBoxItem Content="180" />
                                                        <ComboBoxItem Content="270" />
                                                    </ComboBox>
                                                    <CheckBox x:Name="MirrorHorizontalCheckBox" x:Uid="VideoPage_MirrorHorizontally" Content="Mirror horizontally" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <CheckBox x:Name="MirrorVerticalCheckBox" x:Uid="VideoPage_MirrorVertically" Content="Mirror vertically" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="TransformValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="AdvancedMetadataPanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_Metadata" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Metadata" />
                                                    <CheckBox x:Name="RemoveMetadataCheckBox" x:Uid="VideoPage_RemoveMetadata" Content="Remove metadata" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="AdvancedRepairPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="VideoPage_Repair" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Repair" />
                                                    <CheckBox x:Name="EnableRepairCheckBox" x:Uid="VideoPage_EnableRepair" Content="Enable repair mode" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <ContentControl x:Name="RepairOptionsPanel">
                                                        <StackPanel Spacing="12">
                                                            <ComboBox x:Name="RepairModeComboBox" x:Uid="VideoPage_RepairMode" Header="Repair mode" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                                <ComboBoxItem x:Uid="VideoPage_Remux" Content="Remux" />
                                                                <ComboBoxItem x:Uid="VideoPage_Reencode" Content="Reencode" />
                                                            </ComboBox>
                                                            <CheckBox x:Name="RegeneratePtsCheckBox" x:Uid="VideoPage_RegenerateTimestamps" Content="Regenerate timestamps" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                            <CheckBox x:Name="IgnoreRecoverableErrorsCheckBox" x:Uid="VideoPage_IgnoreErrors" Content="Ignore recoverable errors" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                            <CheckBox x:Name="DropNonEssentialStreamsCheckBox" x:Uid="VideoPage_DropNonEssential" Content="Drop non-essential streams" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                            <CheckBox x:Name="RepairRemoveMetadataCheckBox" x:Uid="VideoPage_RemoveMetadataRepair" Content="Remove metadata during repair" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                        </StackPanel>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="AdvancedValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
