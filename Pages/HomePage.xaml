<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files_Tools.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    mc:Ignorable="d">
    <Grid
        x:Name="LayoutRoot"
        Padding="18"
        SizeChanged="LayoutRoot_SizeChanged">
        <Border
            x:Name="DropZoneSurface"
            AllowDrop="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="32"
            CornerRadius="28"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            DragOver="DropZoneSurface_DragOver"
            Drop="DropZoneSurface_Drop"
            PointerPressed="DropZoneSurface_PointerPressed">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="760"
                    Spacing="16">
                    <Border
                        HorizontalAlignment="Center"
                        Padding="20"
                        CornerRadius="999"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="68"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE898;" />
                    </Border>

                    <TextBlock
                        x:Name="HeaderText"
                        HorizontalAlignment="Center"
                        FontSize="44"
                        FontWeight="SemiBold"
                        Text="Drop an image or video here"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="SubtitleText"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Opacity="0.82"
                        Text="Drop a file anywhere on this screen and the app will open the correct editor with it already loaded. You can also click anywhere on this surface to browse from Explorer."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Opacity="0.68"
                        Text="Images: PNG, JPG, JPEG, BMP, GIF, WebP   •   Video: MP4, MOV, MKV, AVI, WMV, WebM, M4V, GIF"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
