<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files_Tools.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    mc:Ignorable="d">
    <Grid
        x:Name="LayoutRoot"
        Padding="18"
        SizeChanged="LayoutRoot_SizeChanged">
        <Border
            x:Name="DropZoneSurface"
            AllowDrop="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="32"
            CornerRadius="28"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            DragOver="DropZoneSurface_DragOver"
            Drop="DropZoneSurface_Drop"
            PointerPressed="DropZoneSurface_PointerPressed">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="760"
                    Spacing="16">
                    <Border
                        HorizontalAlignment="Center"
                        Padding="20"
                        CornerRadius="999"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="68"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE898;" />
                    </Border>

                    <TextBlock
                        x:Name="HeaderText"
                        HorizontalAlignment="Center"
                        FontSize="44"
                        FontWeight="SemiBold"
                        Text="Drop files to get started"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="SubtitleText"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Opacity="0.82"
                        Text="Drop a single file to open the right editor, or drop multiple files of the same type to batch-process them all at once. You can also browse using the buttons below."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Opacity="0.68"
                        Text="Images: PNG, JPG, WebP, AVIF   •   Video: MP4, MKV, MOV, AVI, WebM   •   Audio: MP3, M4A, FLAC, WAV, OPUS   •   Documents: DOCX, PPTX, XLSX, PDF"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,4,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Grid.Column="1" Text="or browse" Opacity="0.50" />
                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="SingleFileButton"
                            Click="SingleFileButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="15" Glyph="&#xE8A5;" />
                                <TextBlock Text="Single file" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BatchFilesButton"
                            Click="BatchFilesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="15" Glyph="&#xE8B5;" />
                                <TextBlock Text="Multiple files for batch" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
