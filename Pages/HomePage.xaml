<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files_Tools.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Grid
            x:Name="LayoutRoot"
            Padding="32,24,32,28"
            SizeChanged="LayoutRoot_SizeChanged">
            <Grid
                x:Name="ContentContainer"
                HorizontalAlignment="Center"
                MaxWidth="1240"
                RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="HeaderText"
                    HorizontalAlignment="Center"
                    FontSize="44"
                    FontWeight="SemiBold"
                    Text="CHOOSE AN OPTION" />

                <TextBlock
                    x:Name="SubtitleText"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    MaxWidth="940"
                    FontSize="19"
                    Opacity="0.85"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="Pick a tool category to start processing your files quickly." />

                <Grid
                    x:Name="CardsGrid"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    ColumnSpacing="28"
                    RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CardsColumnLeft" Width="*" />
                        <ColumnDefinition x:Name="CardsColumnRight" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="ImagesCardButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Click="ImagesCard_Click">
                        <Border
                            MinHeight="290"
                            Padding="14"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <Border
                                    Height="170"
                                    CornerRadius="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Viewbox Margin="10">
                                        <SymbolIcon Symbol="Pictures" />
                                    </Viewbox>
                                </Border>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="Images" />
                                <TextBlock
                                    Opacity="0.8"
                                    TextWrapping="Wrap"
                                    Text="Resize, convert, and optimize image files." />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button
                        x:Name="VideoCardButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Click="VideoCard_Click">
                        <Border
                            MinHeight="290"
                            Padding="14"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <Border
                                    Height="170"
                                    CornerRadius="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Viewbox Margin="10">
                                        <SymbolIcon Symbol="Video" />
                                    </Viewbox>
                                </Border>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="Video" />
                                <TextBlock
                                    Opacity="0.8"
                                    TextWrapping="Wrap"
                                    Text="Change formats and tune quality for videos." />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button
                        x:Name="DocumentsCardButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Click="DocumentsCard_Click">
                        <Border
                            MinHeight="290"
                            Padding="14"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <Border
                                    Height="170"
                                    CornerRadius="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Viewbox Margin="10">
                                        <SymbolIcon Symbol="Document" />
                                    </Viewbox>
                                </Border>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="Documents" />
                                <TextBlock
                                    Opacity="0.8"
                                    TextWrapping="Wrap"
                                    Text="Manage document conversions in a few clicks." />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button
                        x:Name="AudioCardButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        PointerEntered="Card_PointerEntered"
                        PointerExited="Card_PointerExited"
                        Click="AudioCard_Click">
                        <Border
                            MinHeight="290"
                            Padding="14"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <Border
                                    Height="170"
                                    CornerRadius="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Viewbox Margin="10">
                                        <SymbolIcon Symbol="Audio" />
                                    </Viewbox>
                                </Border>
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="Audio" />
                                <TextBlock
                                    Opacity="0.8"
                                    TextWrapping="Wrap"
                                    Text="Convert and adjust audio files quickly." />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
