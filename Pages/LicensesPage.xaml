<Page
    x:Class="Files_Tools.Pages.LicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24">
            <Grid MaxWidth="1000" HorizontalAlignment="Center" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="34" FontWeight="SemiBold" Text="Licenses" />

                <TextBlock
                    Grid.Row="1"
                    Opacity="0.85"
                    TextWrapping="Wrap"
                    Text="Third-party components used by this app and their licenses." />

                <Border
                    Grid.Row="2"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="libvips" />
                            <TextBlock Opacity="0.82" Text="License: LGPL-3.0-or-later" />
                            <TextBlock Opacity="0.82" Text="Usage: image conversion, compression and resize" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowLibvipsLicense_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
