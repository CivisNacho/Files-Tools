<Page
    x:Class="Files_Tools.Pages.LicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24">
            <Grid MaxWidth="1000" HorizontalAlignment="Center" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Uid="LicensesPage_Title" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="34" FontWeight="SemiBold" Text="Licenses" />

                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock
                        x:Uid="LicensesPage_Subtitle1"
                        Opacity="0.85"
                        TextWrapping="Wrap"
                        Text="Third-party components used by this app, their attributions, and their licenses." />
                    <TextBlock
                        x:Uid="LicensesPage_Subtitle2"
                        Opacity="0.78"
                        TextWrapping="Wrap"
                        Text="Most listed licenses permit commercial use, subject to their terms and any redistribution obligations. Components marked Non-Commercial may not be used for commercial purposes." />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="App Icon" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap">
                                <Run Text="Artwork by O.Marquez on" />
                                <Hyperlink NavigateUri="https://www.instagram.com/wht_yuki/">
                                    <Run Text="Instagram" />
                                </Hyperlink>
                                <Run Text="." />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="Karaoke Effect Templates" />
                        <TextBlock Opacity="0.82" TextWrapping="Wrap">
                            <Run Text="Some of the ASS subtitles ideas and templates came from" />
                            <Hyperlink NavigateUri="https://github.com/Seekladoom/Aegisub-Karaoke-Effect-481-Templates">
                                <Run Text="this repository" />
                            </Hyperlink>
                            <Run Text="." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="4"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="libvips" />
                            <TextBlock Opacity="0.82" Text="License: LGPL-3.0-or-later" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: libvips project, packaged via NetVips.Native.win-x64 / win-arm64" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: image conversion, compression, resize, PDF page rasterization, and PDF image extraction" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowLibvipsLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="5"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="FFmpeg" />
                            <TextBlock Opacity="0.82" Text="License: LGPL-2.1-or-later" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: FFmpeg project, packaged via DevEnvy.FFmpeg.Binaries.LGPL" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: video/audio processing and transcoding" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowFfmpegLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="6"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="DTLN pretrained ONNX models" />
                            <TextBlock Opacity="0.82" Text="License: MIT" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: DTLN project and bundled model files" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: local audio noise suppression model inference" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowDtlnLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="7"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="ONNX Runtime" />
                            <TextBlock Opacity="0.82" Text="License: MIT" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: Microsoft.ML.OnnxRuntime" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: executing DTLN denoise and MMS forced-alignment ONNX models" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowOnnxRuntimeLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="8"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="Whisper.net / whisper.cpp" />
                            <TextBlock Opacity="0.82" Text="License: MIT" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: Whisper.net and whisper.cpp projects" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: local speech-to-text transcription and subtitle generation" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowWhisperLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="9"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="LibreOffice" />
                            <TextBlock Opacity="0.82" Text="License: MPL-2.0" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: The Document Foundation and LibreOffice contributors" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: document format conversion (DOCX, ODT, PPTX, ODP → PDF)" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowLibreOfficeLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="10"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="qpdf / QPdfNet" />
                            <TextBlock Opacity="0.82" Text="License: Apache-2.0" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: qpdf project and QPdfNet wrapper" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: PDF merge, split, reorder, rotate, encrypt, metadata, repair, image and attachment extraction" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowQpdfLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="11"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="20" FontWeight="SemiBold" Text="Tesseract OCR" />
                            <TextBlock Opacity="0.82" Text="License: Apache-2.0" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Attribution: Tesseract project, Leptonica, and TesseractOCR wrapper" />
                            <TextBlock Opacity="0.82" TextWrapping="Wrap" Text="Usage: local OCR of PDF documents to produce searchable PDFs" />
                        </StackPanel>

                        <Button
                            x:Uid="LicensesPage_ShowLicense"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowTesseractLicense_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
