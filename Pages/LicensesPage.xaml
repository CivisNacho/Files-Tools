<Page
    x:Class="Files_Tools.Pages.LicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24">
            <Grid MaxWidth="1000" HorizontalAlignment="Center" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="34" FontWeight="SemiBold" Text="Licenses" />

                <TextBlock
                    Grid.Row="1"
                    Opacity="0.85"
                    TextWrapping="Wrap"
                    Text="Third-party components used by this app and their licenses." />

                <Border
                    Grid.Row="2"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="libvips" />
                            <TextBlock Opacity="0.82" Text="License: LGPL-3.0-or-later" />
                            <TextBlock Opacity="0.82" Text="Usage: image conversion, compression and resize" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowLibvipsLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="FFmpeg" />
                            <TextBlock Opacity="0.82" Text="License: LGPL-2.1-or-later" />
                            <TextBlock Opacity="0.82" Text="Usage: video/audio processing and transcoding" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowFfmpegLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="4"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="DTLN pretrained ONNX models" />
                            <TextBlock Opacity="0.82" Text="License: MIT" />
                            <TextBlock Opacity="0.82" Text="Usage: local audio noise suppression model inference" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowDtlnLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="5"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="ONNX Runtime" />
                            <TextBlock Opacity="0.82" Text="License: MIT" />
                            <TextBlock Opacity="0.82" Text="Usage: executing DTLN ONNX models" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowOnnxRuntimeLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="6"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Whisper.net / whisper.cpp" />
                            <TextBlock Opacity="0.82" Text="License: MIT" />
                            <TextBlock Opacity="0.82" Text="Usage: local speech-to-text transcription and subtitle generation" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowWhisperLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="7"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="LibreOffice" />
                            <TextBlock Opacity="0.82" Text="License: MPL-2.0" />
                            <TextBlock Opacity="0.82" Text="Usage: document format conversion (DOCX, ODT, PPTX, ODP → PDF)" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowLibreOfficeLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="8"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="qpdf / QPdfNet" />
                            <TextBlock Opacity="0.82" Text="License: Apache-2.0" />
                            <TextBlock Opacity="0.82" Text="Usage: PDF merge, split, reorder, rotate, encrypt, metadata, repair, image and attachment extraction" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowQpdfLicense_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="9"
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Tesseract OCR" />
                            <TextBlock Opacity="0.82" Text="License: Apache-2.0" />
                            <TextBlock Opacity="0.82" Text="Usage: local OCR of PDF documents to produce searchable PDFs" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Show License"
                            Click="ShowTesseractLicense_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
