<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files_Tools.Pages.PdfEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  Accent/hint brushes (PdfAccentBrush, PdfAccentDarkBrush, PdfHintBackgroundBrush)
              are defined app-wide and theme-aware in Themes/AppTheme.xaml.  -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid
            x:Name="PageRoot"
            Padding="32,24,32,28"
            SizeChanged="PageRoot_SizeChanged">
            <Grid
                x:Name="ContentRoot"
                HorizontalAlignment="Stretch"
                RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel MaxWidth="880" Spacing="6">
                    <TextBlock x:Uid="PdfPage_Title" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="38" FontWeight="SemiBold" Text="PDF Editor" />
                    <TextBlock
                        x:Uid="PdfPage_Subtitle"
                        Opacity="0.78"
                        Text="Import a PDF, organize pages, add security, and apply edits with a layout that keeps preview and options easy to follow."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                    x:Name="EditorGrid"
                    Grid.Row="1"
                    ColumnSpacing="20"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="9*" />
                        <ColumnDefinition x:Name="RightColumn" Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="PreviewSection"
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Padding="20"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="PreviewTitle" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="24" FontWeight="SemiBold" Text="Preview" />
                                <TextBlock
                                    x:Uid="PdfPage_PreviewHint"
                                    Opacity="0.72"
                                    Text="Drop a PDF or click the preview surface to start. Organization, security, and content edits stay available from the options panel."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                x:Name="UploadSurface"
                                Grid.Row="1"
                                AllowDrop="True"
                                MinHeight="240"
                                Padding="16"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                DragOver="UploadSurface_DragOver"
                                Drop="UploadSurface_Drop"
                                PointerPressed="UploadSurface_PointerPressed">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel
                                        x:Name="ZoomControlPanel"
                                        Visibility="Collapsed"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Padding="0,0,0,8">
                                        <Button
                                            x:Name="ZoomOutButton"
                                            Width="40"
                                            Height="40"
                                            Padding="0"
                                            Click="ZoomOut_Click"
                                            ToolTipService.ToolTip="Zoom out">
                                            <FontIcon FontSize="16" Glyph="&#xE71E;" />
                                        </Button>
                                        <Slider
                                            x:Name="ZoomSlider"
                                            Width="150"
                                            Minimum="50"
                                            Maximum="200"
                                            Value="100"
                                            StepFrequency="10"
                                            ValueChanged="ZoomSlider_ValueChanged"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="ZoomLevelTextBlock"
                                            VerticalAlignment="Center"
                                            Width="50"
                                            Text="100%" />
                                        <Button
                                            x:Name="ZoomInButton"
                                            Width="40"
                                            Height="40"
                                            Padding="0"
                                            Click="ZoomIn_Click"
                                            ToolTipService.ToolTip="Zoom in">
                                            <FontIcon FontSize="16" Glyph="&#xE71F;" />
                                        </Button>
                                        <Button
                                            x:Name="FitToPageButton"
                                            x:Uid="PdfPage_FitPage"
                                            Content="Fit page"
                                            Click="FitToPage_Click" />
                                    </StackPanel>

                                    <ScrollViewer
                                        x:Name="PreviewScrollViewer"
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        PointerWheelChanged="PreviewScrollViewer_PointerWheelChanged">
                                        <Grid
                                            x:Name="PreviewHost"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Background="Transparent">
                                            <Image
                                                x:Name="PdfPageImage"
                                                Stretch="Fill"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top" />

                                            <StackPanel
                                                x:Name="DropHintPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxWidth="360"
                                                Spacing="12">
                                                <Border
                                                    HorizontalAlignment="Center"
                                                    Padding="18"
                                                    CornerRadius="999"
                                                    Background="{StaticResource PdfHintBackgroundBrush}">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        FontSize="52"
                                                        Foreground="{StaticResource PdfAccentDarkBrush}"
                                                        Glyph="&#xE7C3;" />
                                                </Border>
                                                <TextBlock
                                                    x:Uid="PdfPage_DropHintTitle"
                                                    HorizontalAlignment="Center"
                                                    FontFamily="{ThemeResource AppDisplayFontFamily}"
                                                    FontSize="24"
                                                    FontWeight="SemiBold"
                                                    Text="Drop a PDF here"
                                                    TextAlignment="Center" />
                                                <TextBlock
                                                    x:Uid="PdfPage_DropHintSubtitle"
                                                    HorizontalAlignment="Center"
                                                    Opacity="0.76"
                                                    Text="You can also click this surface to browse for a file. Merge, split, encrypt, and content options stay available from the options panel."
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>

                                    <StackPanel
                                        x:Name="PdfNavigationPanel"
                                        Grid.Row="2"
                                        Visibility="Collapsed"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                                        <Button
                                            x:Name="PreviousPageButton"
                                            x:Uid="PdfPage_Previous"
                                            MinWidth="100"
                                            Content="← Previous"
                                            Click="PreviousPage_Click" />
                                        <TextBlock
                                            x:Name="PageCountTextBlock"
                                            VerticalAlignment="Center"
                                            Text="Page 1 of 1" />
                                        <Button
                                            x:Name="NextPageButton"
                                            x:Uid="PdfPage_Next"
                                            MinWidth="100"
                                            Content="Next →"
                                            Click="NextPage_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="LoadedPdfInfoTextBlock"
                                    x:Uid="PdfPage_NoPdfLoaded"
                                    VerticalAlignment="Center"
                                    Opacity="0.76"
                                    Text="No PDF loaded yet."
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="ApplyButton"
                                    x:Uid="ApplyChanges"
                                    Grid.Column="1"
                                    MinWidth="180"
                                    Height="44"
                                    HorizontalAlignment="Right"
                                    Content="Apply changes"
                                    Background="{StaticResource PdfAccentBrush}"
                                    BorderBrush="{StaticResource PdfAccentBrush}"
                                    Foreground="Black"
                                    Click="ApplyButton_Click" />
                            </Grid>

                            <StackPanel
                                x:Name="ProcessingStatusPanel"
                                Grid.Row="3"
                                Visibility="Collapsed"
                                Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="ProcessingStatusTextBlock"
                                        x:Uid="PdfPage_Processing"
                                        FontWeight="SemiBold"
                                        Text="Processing PDF..." />
                                    <TextBlock
                                        x:Name="ProcessingEtaTextBlock"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        Opacity="0.76"
                                        Text="0%" />
                                </Grid>

                                <ProgressBar
                                    x:Name="ProcessingProgressBar"
                                    Height="6"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0" />

                                <TextBlock
                                    x:Name="ProcessingDetailTextBlock"
                                    x:Uid="PdfPage_PreparingService"
                                    Opacity="0.76"
                                    Text="Preparing PDF service..." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="OptionsPanel"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        MinWidth="280"
                        Padding="20"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="SelectedOptionHeaderTextBlock" x:Uid="PdfPage_SelectCategory" Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="Select a category from the left" />

                                    <Border x:Name="FileInfoPanel" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Uid="PdfPage_FileInfoSection" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="File info" />
                                            <Grid ColumnSpacing="10" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Uid="PdfPage_FileInfoName" Opacity="0.72" Text="Name" VerticalAlignment="Top" />
                                                <TextBlock x:Name="FileInfoNameTextBlock" Grid.Column="1" TextWrapping="Wrap" />
                                                <TextBlock x:Uid="PdfPage_FileInfoPages" Grid.Row="1" Opacity="0.72" Text="Pages" />
                                                <TextBlock x:Name="FileInfoPagesTextBlock" Grid.Row="1" Grid.Column="1" />
                                                <TextBlock x:Uid="PdfPage_FileInfoSize" Grid.Row="2" Opacity="0.72" Text="Size" />
                                                <TextBlock x:Name="FileInfoSizeTextBlock" Grid.Row="2" Grid.Column="1" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Organization Panel -->
                                    <StackPanel x:Name="OrganizationPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="MergePanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Merge" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Merge" />
                                                    <TextBlock x:Uid="PdfPage_MergeHint" Opacity="0.76" Text="Combine multiple PDFs into a single document." TextWrapping="Wrap" />
                                                    <Button x:Uid="PdfPage_AddPdf" HorizontalAlignment="Left" Content="Add PDF to merge" Click="AddPdfToMergeButton_Click" />
                                                    <ScrollViewer MinHeight="0" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                                        <StackPanel x:Name="MergeFilesList" Spacing="8" />
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="SplitPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Split" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Split" />
                                                    <ComboBox x:Name="SplitModeComboBox" x:Uid="PdfPage_SplitMode" Header="Split mode" SelectionChanged="SplitModeComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="PdfPage_OnePagePerFile" Content="One page per file" />
                                                        <ComboBoxItem x:Uid="PdfPage_ByPageRanges" Content="By page ranges" />
                                                    </ComboBox>
                                                    <StackPanel x:Name="SplitRangesPanel" Visibility="Collapsed" Spacing="8">
                                                        <TextBox x:Name="SplitRangesTextBox" x:Uid="PdfPage_PageRanges" Header="Page ranges" PlaceholderText="Example: 1-3, 5, 7-9" TextChanged="AnyOptionChanged_TextChanged" />
                                                        <TextBlock x:Uid="PdfPage_PageRangesHint" Opacity="0.76" Text="Specify ranges like 1-3 for pages 1 to 3, or single pages like 5." TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="ReorderPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Reorder" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Reorder" />
                                                    <TextBlock x:Uid="PdfPage_ReorderHint" Opacity="0.76" Text="Rearrange pages by specifying the new order." TextWrapping="Wrap" />
                                                    <TextBox x:Name="ReorderSequenceTextBox" x:Uid="PdfPage_PageOrder" Header="Page order" PlaceholderText="Example: 3, 1, 2, 5, 4" TextChanged="AnyOptionChanged_TextChanged" />
                                                    <TextBlock x:Uid="PdfPage_PageOrderHint" Opacity="0.76" Text="List page numbers in the desired order, separated by commas." TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="ExtractPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Extract" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Extract" />
                                                    <CheckBox x:Name="ExtractImagesCheckBox" x:Uid="PdfPage_ExtractImages" Content="Extract images" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <CheckBox x:Name="ExtractAttachmentsCheckBox" x:Uid="PdfPage_ExtractAttachments" Content="Extract attachments" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <TextBlock x:Uid="PdfPage_ExtractHint" Opacity="0.76" Text="Extracted files will be saved to separate folders." TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="OrganizationValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Transform Panel -->
                                    <StackPanel x:Name="TransformPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="RotatePanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Rotate" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Rotate" />
                                                    <ComboBox x:Name="RotationComboBox" x:Uid="PdfPage_Rotation" Header="Rotation" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                        <ComboBoxItem x:Uid="PdfPage_0Degrees" Content="0 degrees" />
                                                        <ComboBoxItem x:Uid="PdfPage_90CW" Content="90 degrees clockwise" />
                                                        <ComboBoxItem x:Uid="PdfPage_180Degrees" Content="180 degrees" />
                                                        <ComboBoxItem x:Uid="PdfPage_270CW" Content="270 degrees clockwise" />
                                                    </ComboBox>
                                                    <ComboBox x:Name="RotationScopeComboBox" x:Uid="PdfPage_ApplyTo" Header="Apply to" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                        <ComboBoxItem x:Uid="PdfPage_AllPages" Content="All pages" />
                                                        <ComboBoxItem x:Uid="PdfPage_CurrentPage" Content="Current page" />
                                                        <ComboBoxItem x:Uid="PdfPage_SelectedPages" Content="Selected pages" />
                                                    </ComboBox>
                                                    <StackPanel x:Name="RotationPagesPanel" Visibility="Collapsed" Spacing="4">
                                                        <TextBox x:Name="RotationPagesTextBox" x:Uid="PdfPage_PageNumbers" Header="Page numbers" PlaceholderText="Example: 1, 3-5, 7" TextChanged="AnyOptionChanged_TextChanged" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="TransformValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Security Panel -->
                                    <StackPanel x:Name="SecurityPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="EncryptPanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Encrypt" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Encrypt" />
                                                    <PasswordBox x:Name="EncryptPasswordBox" x:Uid="PdfPage_Password" Header="Password" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                    <PasswordBox x:Name="EncryptConfirmPasswordBox" x:Uid="PdfPage_ConfirmPassword" Header="Confirm password" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                    <CheckBox x:Name="EncryptOwnerPasswordCheckBox" x:Uid="PdfPage_SetOwnerPassword" Content="Set owner password" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <StackPanel x:Name="EncryptOwnerPasswordPanel" Visibility="Collapsed" Spacing="4">
                                                        <PasswordBox x:Name="EncryptOwnerPasswordBox" x:Uid="PdfPage_OwnerPassword" Header="Owner password" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="PasswordManagementPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_PasswordSection" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Password" />
                                                    <ComboBox x:Name="PasswordActionComboBox" x:Uid="PdfPage_PasswordAction" Header="Action" SelectionChanged="PasswordActionComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Uid="PdfPage_RemovePassword" Content="Remove password" />
                                                        <ComboBoxItem x:Uid="PdfPage_ChangePassword" Content="Change password" />
                                                    </ComboBox>
                                                    <StackPanel x:Name="RemovePasswordPanel" Visibility="Visible" Spacing="4">
                                                        <PasswordBox x:Name="CurrentPasswordBox" x:Uid="PdfPage_CurrentPassword" Header="Current password" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                        <TextBlock x:Uid="PdfPage_RemovePasswordHint" Opacity="0.76" Text="Enter the PDF's current password to remove protection." TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel x:Name="ChangePasswordPanel" Visibility="Collapsed" Spacing="4">
                                                        <PasswordBox x:Name="OldPasswordBox" x:Uid="PdfPage_CurrentPassword" Header="Current password" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                        <PasswordBox x:Name="NewPasswordBox" x:Uid="PdfPage_NewPassword" Header="New password" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                        <PasswordBox x:Name="ConfirmNewPasswordBox" x:Uid="PdfPage_ConfirmNewPassword" Header="Confirm new password" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="PermissionsPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_PermissionsSection" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Permissions" />
                                                    <TextBlock x:Uid="PdfPage_PermissionsHint" Opacity="0.76" Text="Control what users can do with the PDF." TextWrapping="Wrap" />
                                                    <CheckBox x:Name="AllowPrintingCheckBox" x:Uid="PdfPage_AllowPrinting" Content="Allow printing" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <CheckBox x:Name="AllowCopyingCheckBox" x:Uid="PdfPage_AllowCopying" Content="Allow copying text and images" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <CheckBox x:Name="AllowEditingCheckBox" x:Uid="PdfPage_AllowEditing" Content="Allow editing" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <CheckBox x:Name="AllowAnnotationsCheckBox" x:Uid="PdfPage_AllowAnnotations" Content="Allow annotations" IsChecked="True" Checked="AnyOptionChanged_CheckChanged" Unchecked="AnyOptionChanged_CheckChanged" />
                                                    <PasswordBox x:Name="PermissionsOwnerPasswordBox" x:Uid="PdfPage_PermissionsOwnerPassword" Header="Owner password (optional)" PasswordChanged="AnyOptionChanged_PasswordChanged" />
                                                    <TextBlock x:Uid="PdfPage_PermissionsOwnerPasswordHint" Opacity="0.76" Text="Optional. Leave blank to apply restrictions without a password; set one to require it before the restrictions can be removed." TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="SecurityValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Content Panel -->
                                    <StackPanel x:Name="ContentPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="OcrPanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_OCR" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="OCR" />
                                                    <TextBlock x:Uid="PdfPage_OcrHint" Opacity="0.76" Text="Make scanned PDFs searchable by recognizing text." TextWrapping="Wrap" />
                                                    <ComboBox x:Name="OcrLanguageComboBox" x:Uid="PdfPage_OcrLanguage" Header="Language" SelectionChanged="AnyOptionChanged_SelectionChanged">
                                                        <ComboBoxItem Content="English" />
                                                        <ComboBoxItem Content="Spanish" />
                                                        <ComboBoxItem Content="French" />
                                                        <ComboBoxItem Content="German" />
                                                        <ComboBoxItem Content="Chinese" />
                                                        <ComboBoxItem Content="Japanese" />
                                                        <ComboBoxItem x:Uid="PdfPage_OcrAutoDetect" Content="Auto-detect" />
                                                    </ComboBox>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock x:Uid="PdfPage_OcrTessDataLabel" FontSize="12" Opacity="0.72" Text="Tessdata directory" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                x:Name="OcrTessDataTextBox"
                                                                IsReadOnly="True"
                                                                PlaceholderText="Not set — click Browse"
                                                                VerticalAlignment="Center" />
                                                            <Button
                                                                x:Name="BrowseTessDataButton"
                                                                x:Uid="PdfPage_OcrBrowse"
                                                                Grid.Column="1"
                                                                Content="Browse"
                                                                Click="BrowseTessData_Click" />
                                                        </Grid>
                                                        <TextBlock
                                                            x:Uid="PdfPage_OcrTessDataHint"
                                                            FontSize="12"
                                                            Opacity="0.72"
                                                            Text="Folder with .traineddata language packs. Auto-detected from %LOCALAPPDATA%\FilesTools\tessdata if present."
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!--  Appears when the chosen language pack is absent; hides on success  -->
                                                    <StackPanel x:Name="OcrDownloadPanel" Visibility="Collapsed" Spacing="6">
                                                        <Button
                                                            x:Name="DownloadTessDataButton"
                                                            HorizontalAlignment="Left"
                                                            Content="Download language pack"
                                                            Click="DownloadTessData_Click" />
                                                        <ProgressBar
                                                            x:Name="OcrDownloadProgressBar"
                                                            Height="4"
                                                            IsIndeterminate="True"
                                                            Visibility="Collapsed" />
                                                        <TextBlock
                                                            x:Name="OcrDownloadStatusTextBlock"
                                                            FontSize="12"
                                                            Opacity="0.76"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="MetadataPanel" Visibility="Collapsed">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Metadata" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Metadata" />
                                                    <TextBox x:Name="MetadataTitleTextBox" x:Uid="PdfPage_MetadataTitle" Header="Title" PlaceholderText="Document title" TextChanged="AnyOptionChanged_TextChanged" />
                                                    <TextBox x:Name="MetadataAuthorTextBox" x:Uid="PdfPage_MetadataAuthor" Header="Author" PlaceholderText="Author name" TextChanged="AnyOptionChanged_TextChanged" />
                                                    <TextBox x:Name="MetadataSubjectTextBox" x:Uid="PdfPage_MetadataSubject" Header="Subject" PlaceholderText="Document subject" TextChanged="AnyOptionChanged_TextChanged" />
                                                    <TextBox x:Name="MetadataKeywordsTextBox" x:Uid="PdfPage_MetadataKeywords" Header="Keywords" PlaceholderText="Comma-separated keywords" TextChanged="AnyOptionChanged_TextChanged" />
                                                    <TextBox x:Name="MetadataCreatorTextBox" x:Uid="PdfPage_MetadataCreator" Header="Creator" PlaceholderText="Creator application" IsReadOnly="True" />
                                                    <TextBox x:Name="MetadataProducerTextBox" x:Uid="PdfPage_MetadataProducer" Header="Producer" PlaceholderText="Producer application" IsReadOnly="True" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="ContentValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Repair Panel -->
                                    <StackPanel x:Name="RepairPanel" Visibility="Collapsed" Spacing="12">

                                        <StackPanel x:Name="RepairOptionsPanel" Visibility="Visible">
                                            <Border Style="{StaticResource SettingsCardStyle}">
                                                <StackPanel Spacing="12">
                                                    <TextBlock x:Uid="PdfPage_Repair" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Repair" />
                                                    <TextBlock x:Uid="PdfPage_RepairHint" Opacity="0.76" Text="Fix corrupted or damaged PDF files." TextWrapping="Wrap" />
                                                    <Button x:Uid="PdfPage_RepairButton" HorizontalAlignment="Left" Content="Repair PDF" Click="RepairButton_Click" />
                                                    <TextBlock x:Name="RepairStatusTextBlock" x:Uid="PdfPage_RepairReady" Opacity="0.76" Text="Ready to repair." TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="RepairValidationTextBlock" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
