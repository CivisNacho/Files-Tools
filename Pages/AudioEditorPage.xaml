<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Files_Tools.Pages.AudioEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  Accent/hint brushes (Image*/Audio* accent + AudioHintBackgroundBrush) are defined
              app-wide and theme-aware in Themes/AppTheme.xaml.  -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageRoot" Padding="32,24,32,28" SizeChanged="PageRoot_SizeChanged">
            <Grid x:Name="ContentRoot" HorizontalAlignment="Stretch" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel MaxWidth="880" Spacing="6">
                    <TextBlock x:Uid="AudioPage_Title" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="38" FontWeight="SemiBold" Text="Audio Editor" />
                    <TextBlock x:Uid="AudioPage_Subtitle" Opacity="0.78" Text="Load an audio file, build a processing chain, and apply all selected operations in one run." TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="EditorGrid" Grid.Row="1" ColumnSpacing="20" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="7*" />
                        <ColumnDefinition x:Name="RightColumn" Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PreviewSection" Grid.Column="0" VerticalAlignment="Top" Padding="20" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="PreviewTitle" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="24" FontWeight="SemiBold" Text="Preview" />
                                <TextBlock x:Uid="AudioPage_PreviewHint" Opacity="0.72" Text="Drop an audio file or click the surface to pick one. Processing status appears below when running." TextWrapping="Wrap" />
                            </StackPanel>

                            <Border x:Name="UploadSurface" Grid.Row="1" AllowDrop="True" MinHeight="200" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Top" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" DragOver="UploadSurface_DragOver" Drop="UploadSurface_Drop" PointerPressed="UploadSurface_PointerPressed">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel x:Name="PreviewHost" Spacing="12" VerticalAlignment="Center">
                                        <MediaPlayerElement
                                            x:Name="AudioPlayer"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            MinHeight="120"
                                            AreTransportControlsEnabled="True"
                                            AutoPlay="False"
                                            Visibility="Collapsed" />

                                        <StackPanel Spacing="8">
                                            <TextBlock x:Uid="AudioPage_AudioDetails" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="Audio details" />
                                            <TextBlock x:Name="PreviewCodecTextBlock" x:Uid="AudioPage_PreviewCodec" Opacity="0.8" Text="Codec: —" />
                                            <TextBlock x:Name="PreviewRateTextBlock" x:Uid="AudioPage_PreviewRate" Opacity="0.8" Text="Sample rate: —" />
                                            <TextBlock x:Name="PreviewChannelsTextBlock" x:Uid="AudioPage_PreviewChannels" Opacity="0.8" Text="Channels: —" />
                                            <TextBlock x:Name="PreviewDurationTextBlock" x:Uid="AudioPage_PreviewDuration" Opacity="0.8" Text="Duration: —" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="TrimTimelinePanel"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        Spacing="8">
                                        <TextBlock
                                            x:Name="TrimSelectionInfoTextBlock"
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="00:00:00 - 00:00:00" />

                                        <Grid>
                                            <Canvas
                                                x:Name="TrimTimelineCanvas"
                                                Height="36"
                                                HorizontalAlignment="Stretch"
                                                SizeChanged="TrimTimelineCanvas_SizeChanged"
                                                PointerMoved="TrimTimelineCanvas_PointerMoved"
                                                PointerReleased="TrimTimelineCanvas_PointerReleased"
                                                PointerCanceled="TrimTimelineCanvas_PointerReleased">
                                                <Border
                                                    x:Name="TrimTimelineRail"
                                                    Height="6"
                                                    Width="0"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                <Border
                                                    x:Name="TrimSelectedRange"
                                                    Height="6"
                                                    Width="0"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Border
                                                    x:Name="TrimStartHandle"
                                                    Width="16"
                                                    Height="24"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    PointerPressed="TrimHandle_PointerPressed"
                                                    Tag="Start" />
                                                <Border
                                                    x:Name="TrimEndHandle"
                                                    Width="16"
                                                    Height="24"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    PointerPressed="TrimHandle_PointerPressed"
                                                    Tag="End" />
                                            </Canvas>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="TrimStartTimeTextBlock"
                                                Text="00:00:00"
                                                Opacity="0.76" />
                                            <TextBlock
                                                x:Name="TrimEndTimeTextBlock"
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Text="00:00:00"
                                                Opacity="0.76" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="DropHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="2" MaxWidth="360" Spacing="12">
                                        <Border HorizontalAlignment="Center" Padding="18" CornerRadius="999" Background="{StaticResource AudioHintBackgroundBrush}">
                                            <FontIcon HorizontalAlignment="Center" FontSize="52" Foreground="{StaticResource AudioAccentDarkBrush}" Glyph="&#xE189;" />
                                        </Border>
                                        <TextBlock x:Uid="AudioPage_DropHintTitle" HorizontalAlignment="Center" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="24" FontWeight="SemiBold" Text="Drop audio here" TextAlignment="Center" />
                                        <TextBlock x:Uid="AudioPage_DropHintSubtitle" HorizontalAlignment="Center" Opacity="0.76" Text="Click to browse a track. Format, normalization, trim, EQ, denoise, and metadata tools are in the options panel." TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="LoadedAudioInfoTextBlock" x:Uid="AudioPage_NoAudioLoaded" VerticalAlignment="Center" Opacity="0.76" Text="No audio loaded yet." TextWrapping="Wrap" />

                                <Button x:Name="ApplyButton" x:Uid="ApplyChanges" Grid.Column="1" MinWidth="180" Height="44" HorizontalAlignment="Right" Content="Apply changes" Background="{StaticResource ImageAccentBrush}" BorderBrush="{StaticResource ImageAccentBrush}" Foreground="White" Click="ApplyButton_Click" />
                            </Grid>

                            <StackPanel x:Name="ProcessingStatusPanel" Grid.Row="3" Visibility="Collapsed" Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProcessingStatusTextBlock" x:Uid="AudioPage_Processing" FontWeight="SemiBold" Text="Processing audio..." />
                                    <TextBlock x:Name="ProcessingEtaTextBlock" Grid.Column="1" Opacity="0.76" Text="0%" />
                                </Grid>

                                <ProgressBar x:Name="ProcessingProgressBar" Height="6" Minimum="0" Maximum="1" Value="0" />

                                <TextBlock x:Name="ProcessingDetailTextBlock" x:Uid="AudioPage_PreparingPipeline" Opacity="0.76" Text="Preparing pipeline..." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="OptionsPanel" Grid.Column="1" Grid.RowSpan="3" MinWidth="280" Padding="20" CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="SelectedOptionHeaderTextBlock" x:Uid="SelectOptionHeader" Margin="0,0,0,12" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="22" FontWeight="SemiBold" Text="Select an option" />

                                    <Border x:Name="FileInfoPanel" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Uid="AudioPage_FileInfoSection" FontFamily="{ThemeResource AppDisplayFontFamily}" FontSize="18" FontWeight="SemiBold" Text="File info" />
                                            <Grid ColumnSpacing="10" RowSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Uid="AudioPage_FileInfoName" Opacity="0.72" Text="Name" VerticalAlignment="Top" />
                                                <TextBlock x:Name="FileInfoNameTextBlock" Grid.Column="1" TextWrapping="Wrap" />
                                                <TextBlock x:Uid="AudioPage_FileInfoDuration" Grid.Row="1" Opacity="0.72" Text="Duration" />
                                                <TextBlock x:Name="FileInfoDurationTextBlock" Grid.Row="1" Grid.Column="1" />
                                                <TextBlock x:Uid="AudioPage_FileInfoFormat" Grid.Row="2" Opacity="0.72" Text="Format" />
                                                <TextBlock x:Name="FileInfoFormatTextBlock" Grid.Row="2" Grid.Column="1" />
                                                <TextBlock x:Uid="AudioPage_FileInfoSize" Grid.Row="3" Opacity="0.72" Text="Size" />
                                                <TextBlock x:Name="FileInfoSizeTextBlock" Grid.Row="3" Grid.Column="1" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="MediaPanel" Visibility="Collapsed" Spacing="12" />
                                    <StackPanel x:Name="TransformPanel" Visibility="Collapsed" Spacing="12" />
                                    <StackPanel x:Name="AdjustPanel" Visibility="Collapsed" Spacing="12" />
                                    <StackPanel x:Name="TranscriptionPanel" Visibility="Collapsed" Spacing="12" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
