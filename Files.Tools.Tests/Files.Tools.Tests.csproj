<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Pin to x64: the test project only pulls x64 natives, and QPdfNet's x86 payload is
         incomplete (missing vcruntime140_1.dll) which breaks RID-less builds. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.2" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="QPdfNet" Version="1.5.0" />
    <PackageReference Include="TesseractOCR" Version="5.3.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!-- QPdfNet's package targets unconditionally copy an x86\vcruntime140_1.dll that does not
       exist in the package, failing the build. The tests are x64-only; drop the x86 items. -->
  <Target Name="RemoveBrokenQpdfX86Items" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.Link)').StartsWith('x86'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Services (renamed from Phase 1/2) -->
    <Compile Include="..\Services\ImageService.cs" Link="Services\ImageService.cs" />
    <Compile Include="..\Services\AudioService.cs" Link="Services\AudioService.cs" />
    <Compile Include="..\Services\FfmpegLocator.cs" Link="Services\FfmpegLocator.cs" />
    <Compile Include="..\Services\TranscriptionService.cs" Link="Services\TranscriptionService.cs" />
    <Compile Include="..\Services\Wav2Vec2AlignmentService.cs" Link="Services\Wav2Vec2AlignmentService.cs" />
    <Compile Include="..\Services\DeepFilterNetService.cs" Link="Services\DeepFilterNetService.cs" />
    <Compile Include="..\Services\FlashSrService.cs" Link="Services\FlashSrService.cs" />
    <Compile Include="..\Services\VoiceStudioService.cs" Link="Services\VoiceStudioService.cs" />
    <Compile Include="..\Services\SubtitleService.cs" Link="Services\SubtitleService.cs" />
    <Compile Include="..\Services\Presets\SubtitlePresetDto.cs" Link="Services\Presets\SubtitlePresetDto.cs" />
    <Compile Include="..\Services\Presets\SubtitleColorJsonConverter.cs" Link="Services\Presets\SubtitleColorJsonConverter.cs" />
    <Compile Include="..\Services\Presets\SubtitlePresetJsonContext.cs" Link="Services\Presets\SubtitlePresetJsonContext.cs" />
    <Compile Include="..\Services\Presets\SubtitlePresetMapper.cs" Link="Services\Presets\SubtitlePresetMapper.cs" />
    <Compile Include="..\Services\Presets\SubtitlePresetLoader.cs" Link="Services\Presets\SubtitlePresetLoader.cs" />
    <Compile Include="..\Services\VideoService.cs" Link="Services\VideoService.cs" />
    <Compile Include="..\Services\AudioDenoiseService.cs" Link="Services\AudioDenoiseService.cs" />
    <Compile Include="..\Services\DocumentService.cs" Link="Services\DocumentService.cs" />
    <!-- Infrastructure helpers (Phase 2) -->
    <Compile Include="..\Services\Infrastructure\TempWorkspace.cs" Link="Services\Infrastructure\TempWorkspace.cs" />
    <Compile Include="..\Services\Infrastructure\WavIo.cs" Link="Services\Infrastructure\WavIo.cs" />
    <Compile Include="..\Services\Infrastructure\FfmpegProgress.cs" Link="Services\Infrastructure\FfmpegProgress.cs" />
    <Compile Include="..\Services\Infrastructure\ProcessRunner.cs" Link="Services\Infrastructure\ProcessRunner.cs" />
    <!-- Helpers -->
    <Compile Include="..\Helpers\EtaEstimator.cs" Link="Helpers\EtaEstimator.cs" />
    <Compile Include="..\Services\PdfService.cs" Link="Services\PdfService.cs" />
    <Compile Include="..\Services\PdfNativeCli.cs" Link="Services\PdfNativeCli.cs" />
  </ItemGroup>

</Project>
