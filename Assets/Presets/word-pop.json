{
  "schemaVersion": 1,
  "id": "WordPop",
  "displayName": "Word Pop",
  "kind": "Karaoke",
  "assStyleName": "WordPop",
  "scriptTitle": "Karaoke subtitles",
  "playResX": 1920,
  "playResY": 1080,
  "wrapStyle": 2,
  "scaledBorderAndShadow": true,
  "primaryFontFamily": "Montserrat",
