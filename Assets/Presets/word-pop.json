  "shadowColor": "#A0000000",
  "karaokeHighlightColor": "#00FFD800",
  "useBackgroundBox": false,
  "outlineWidth": 8,
  "shadowDepth": 1.5,
  "alignment": "Center",
  "marginLeft": 120,
  "marginRight": 120,
  "marginVertical": 0,
  "maxLines": 1,
  "maxCharsPerLine": 22,
  "maxWordsPerChunk": 3,
  "presentationAnimation": "None",
