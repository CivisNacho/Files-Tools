<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Files_Tools</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <InternalsVisibleTo>Files.Tools.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\Models\Dtln\model_1.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Models\Dtln\model_2.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--  Brand fonts (Inter + Poppins, SIL OFL). Shipped with the app and loaded via ms-appx.  -->
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Files.Tools.Tests\**\*.cs" />
    <None Remove="Files.Tools.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevEnvy.FFmpeg.Binaries.LGPL" Version="8.0.1.4" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <PackageReference Include="NetVips.Native.win-arm64" Version="8.18.2" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.2" />
    <PackageReference Include="NetVips.Native.win-x86" Version="8.18.2" />
    <PackageReference Include="QPdfNet" Version="1.5.0" />
    <PackageReference Include="TesseractOCR" Version="5.3.5" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Auto</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <PackageCertificateKeyFile>Files Tools_TemporaryKey.pfx</PackageCertificateKeyFile>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
  </PropertyGroup>

  <!--
    QPdfNet 1.5.0 ships an x86/vcruntime140_1.dll reference in its .targets file but does
    not include the actual file in the package. Strip the broken entry before MSBuild tries
    to copy it. The x64 and ARM64 paths are unaffected.
  -->
  <Target Name="StripMissingQPdfNetNativeRefs" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(Filename)%(Extension)' == 'vcruntime140_1.dll' and $([System.String]::Copy('%(FullPath)').Contains('qpdfnet')) and $([System.String]::Copy('%(FullPath)').Contains('\x86\'))" />
    </ItemGroup>
  </Target>

  <!--
    LibreOffice is not bundled with the app.
    It is downloaded on-demand by LibreOfficeSetupService when the user first opens
    the Document Editor and clicks "Download LibreOffice".
    Downloaded binaries are stored in %LOCALAPPDATA%\FilesTools\libreoffice\<rid>\.
  -->

  <!--
    win-arm64 FFmpeg binaries.
    DevEnvy.FFmpeg.Binaries.LGPL does not ship a win-arm64 build, so we bundle
    the LGPL shared-library build from BtbN ourselves, stored under
    Binaries\ffmpeg\win-arm64\.  The targets below copy them to the same output
    layout that the DevEnvy package uses for other platforms:
      $(OutDir)ffmpeg\win-arm64\*
    so FfmpegLocator resolves them via the standard bundled-path logic.
  -->
  <Target Name="CopyFfmpegArm64Binaries" AfterTargets="Build">
    <ItemGroup>
      <_FfmpegArm64Files Include="$(MSBuildThisFileDirectory)Binaries\ffmpeg\win-arm64\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfmpegArm64Files)"
          DestinationFolder="$(OutDir)ffmpeg\win-arm64"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishFfmpegArm64Binaries" AfterTargets="Publish">
    <ItemGroup>
      <_FfmpegArm64PublishFiles Include="$(MSBuildThisFileDirectory)Binaries\ffmpeg\win-arm64\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfmpegArm64PublishFiles)"
          DestinationFolder="$(PublishDir)ffmpeg\win-arm64"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
